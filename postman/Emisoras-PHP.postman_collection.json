    {
      "name": "07 Obtener emisora por id",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/emisoras/emi-100"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
