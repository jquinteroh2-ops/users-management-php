{
  "info": {
    "name": "Emisoras - PHP Hexagonal (Ejercicio 25)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "CRUDL de Emisora por la API JSON. Ejecutar en orden con el Collection Runner (la petición 01 inicia sesión y Postman guarda la cookie). Cambie baseUrl para probar en Render."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081/public/index.php"
    }
  ],
  "item": [
    {
      "name": "00 Listar sin sesión (401)",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/emisoras"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 401', () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "01 Iniciar sesión (guarda cookie PHPSESSID)",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}?route=auth.authenticate",
        "body": {
          "mode": "urlencoded",
          "urlencoded": [
            {
              "key": "email",
              "value": "admin@example.com"
            },
            {
              "key": "password",
              "value": "Admin1234!"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Listar emisoras",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/emisoras"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Es un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Crear emisora",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/emisoras",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"emi-100\",\n  \"nombre\": \"Radio Prueba Postman\",\n  \"canal\": \"HJPP\",\n  \"bandaFm\": 104.3,\n  \"bandaAm\": null,\n  \"numLocutores\": 3,\n  \"genero\": \"MUSICAL\",\n  \"horario\": \"24 horas\",\n  \"patrocinador\": \"Tienda La Esquina\",\n  \"pais\": \"Colombia\",\n  \"descripcion\": \"Emisora creada desde Postman\",\n  \"numProgramas\": 6,\n  \"numCiudades\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201', () => pm.response.to.have.status(201));",
              "pm.test('Devuelve el id', () => pm.expect(pm.response.json().id).to.eql('emi-100'));"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Crear emisora duplicada (409)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/emisoras",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"emi-100\",\n  \"nombre\": \"Radio Prueba Postman\",\n  \"canal\": \"HJPP\",\n  \"bandaFm\": 104.3,\n  \"bandaAm\": null,\n  \"numLocutores\": 3,\n  \"genero\": \"MUSICAL\",\n  \"horario\": \"24 horas\",\n  \"patrocinador\": \"Tienda La Esquina\",\n  \"pais\": \"Colombia\",\n  \"descripcion\": \"Emisora creada desde Postman\",\n  \"numProgramas\": 6,\n  \"numCiudades\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 409', () => pm.response.to.have.status(409));"
            ]
          }
        }
      ]
    },
