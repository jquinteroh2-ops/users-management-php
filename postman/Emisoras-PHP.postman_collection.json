    },
    {
      "name": "09 Actualizar emisora",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/emisoras/emi-100",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Radio Prueba Postman FM-AM\",\n  \"canal\": \"HJPP\",\n  \"bandaFm\": 104.3,\n  \"bandaAm\": 1250,\n  \"numLocutores\": 5,\n  \"genero\": \"VARIEDADES\",\n  \"horario\": \"24 horas\",\n  \"patrocinador\": \"Tienda La Esquina\",\n  \"pais\": \"Colombia\",\n  \"descripcion\": \"Emisora creada desde Postman\",\n  \"numProgramas\": 6,\n  \"numCiudades\": 2\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200', () => pm.response.to.have.status(200));",
              "pm.test('Ahora tiene AM', () => pm.expect(pm.response.json().bandaAm).to.eql(1250));"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Actualizar con nombre de otra emisora (409)",
      "request": {
        "method": "PUT",
